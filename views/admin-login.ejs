<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="utf-8">
  <title>CHaser 運営ページ</title>
  <link rel="icon" href="/images/favicon.ico">
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link rel='stylesheet' href='/stylesheets/admin.css' />
</head>

<body>

  <div class="header">
    <div class="back_page">
      <div class="back_button"><a href="/"></a></div>
    </div>
    <div class="control_area">
      <div class="page_title">
        <h1><span class="page_title_span">運営</span><%- title %></h1>
      </div>
    </div>
  </div>

  <div class="admin_area">
    <div class="admin_card admin_login">
      <% if (keyRequired) { %>
        <h2 class="admin_card_title">合言葉を入力してください</h2>
        <% if (failed) { %>
          <p class="admin_error">合言葉が違います。</p>
        <% } %>
        <form method="post" action="/admin/login">
          <input type="hidden" name="returnTo" value="<%= returnTo %>">
          <input class="admin_input" type="password" name="admin_key"
                 placeholder="合言葉" autocomplete="current-password" autofocus required>
          <button class="admin_button" type="submit">入る</button>
        </form>
      <% } else { %>
        <h2 class="admin_card_title">この端末からは操作できません</h2>
        <p class="admin_note">
          環境変数 <code>ADMIN_KEY</code> が設定されていないため、
          サーバー機のブラウザ (localhost) からのみ運営ページを開けます。
        </p>
        <p class="admin_note">
          別の端末から操作したい場合は、サーバーを起動するときに合言葉を設定してください。
        </p>
        <pre class="admin_pre">ADMIN_KEY=好きな合言葉 npm start</pre>
      <% } %>
    </div>
  </div>

</body>

</html>
